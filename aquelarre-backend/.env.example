# Puerto del servidor
PORT=4000
NODE_ENV=development
# Cadena de conexión a PostgreSQL (local con Docker o Neon en producción)
DATABASE_URL="postgresql://aquelarre:aquelarre@localhost:5434/aquelarre_db?schema=public"
# Secreto para firmar los tokens JWT (cambiar en producción)
JWT_SECRET="cambia-este-secreto"
JWT_EXPIRES_IN="8h"
# Origen permitido para CORS (FrontEnd)
CORS_ORIGIN="http://localhost:5173"
